{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.milisp.mcp-linker/airtable",
  "title": "airtable",
  "description": "Read/write records, manage bases and tables",
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "airtable-mcp-server",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "AIRTABLE_API_KEY",
          "placeholder": "YOUR_AIRTABLE_API_KEY",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "io.github.milisp.mcp-linker": {
        "configName": "airtable",
        "category": "Database & Data"
      }
    }
  }
}
