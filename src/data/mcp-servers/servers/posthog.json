{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.milisp.mcp-linker/posthog",
  "title": "PostHog",
  "description": "Query product analytics, feature flags, and experiments",
  "version": "1.0.0",
  "repository": {
    "url": "https://github.com/PostHog/posthog",
    "source": "github",
    "subfolder": "services/mcp"
  },
  "icons": [
    {
      "src": "https://cdn.jsdelivr.net/gh/milisp/mcp-servers@main/icons/posthog.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.posthog.com/mcp",
      "headers": [
        {
          "description": "Bearer token with your PostHog personal API key (format: Bearer <key>). Create one at https://us.posthog.com/settings/user-api-keys with the 'MCP Server' preset.",
          "isRequired": true,
          "isSecret": true,
          "name": "Authorization"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "io.github.milisp.mcp-linker": {
        "configName": "posthog",
        "category": "Analytics"
      }
    }
  }
}
