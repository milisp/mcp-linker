{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.milisp.mcp-linker/clickup",
  "title": "clickup",
  "description": "Task management, project tracking",
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@hauptsache.net/clickup-mcp",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CLICKUP_API_KEY",
          "placeholder": "YOUR_CLICKUP_API_KEY",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "CLICKUP_TEAM_ID",
          "placeholder": "YOUR_TEAM_ID",
          "isRequired": true,
          "isSecret": false
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "io.github.milisp.mcp-linker": {
        "configName": "clickup",
        "category": "Project Management"
      }
    }
  }
}
